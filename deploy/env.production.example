# 正式环境配置模板
# 用法：在项目根目录执行  cp deploy/env.production.example .env.production  然后改成真实值
# .env.production 已在 .gitignore 中，不要提交到仓库。

NODE_ENV=production

# 监听地址：
#   127.0.0.1 —— 只允许本机访问，由 Nginx 反代对外（推荐）
#   0.0.0.0   —— 直接对外暴露 3000 端口（需在阿里云安全组放行）
HOST=127.0.0.1
PORT=3000

# ---- MySQL ----
# 正式库在服务器本机；container 用 host 网络模式，所以这里就是宿主机的 127.0.0.1
DB_HOST_PROD=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写正式库密码
DB_DATABASE=DragonNest

DB_POOL_SIZE=10
